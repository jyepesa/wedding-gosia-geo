---
//DGreek
import Layout from "../../layouts/Layout.astro";
import { gr } from "../../i18n/gr";
import LangButton from "../../components/lang-button.astro";

const title = gr.meta.title;
---

<Layout title={title} language="gr">
  <div class="page">
    <main>
      <LangButton />
      <section class="opening">
        <h1 class="opening__title">{gr.heading.title}</h1>
        <div class="opening__time-date">
          <p>{gr.heading["date-city"].city}</p>
          <p>{gr.heading["date-city"].date}</p>
        </div>
        <p class="opening__wedding-type">{gr.heading.type}</p>
        <h2 class="opening__announcement" set:html={gr.heading.announcement} />
        <img src="/wedding-gosia-geo/guinea-pigs.jpg" alt="" />
      </section>
      <section>
        <div class="invitation">
          <h2 class="invitation__title">{gr.invitation.title}</h2>
          <p class="invitation__message" set:html={gr.invitation.message} />
        </div>
        <div class="location">
          <h2 class="location__title">ο χώρος μας!</h2>
          <div class="location__container">
            <a
              href="https://oycowizna.pl/en/"
              class="venue-link"
              target="_blank"
            >
              <img
                class="venue-link__img"
                src="/wedding-gosia-geo/gosciniec-logo.jpg"
                alt="Unsere Veranstaltungsort"
              />
            </a>
            <iframe
              src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d31863.7103417938!2d20.901839591613616!3d52.10417369509804!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x471931a459c1aa57%3A0xb3a863a664a6e56f!2sGo%C5%9Bciniec%20Oycowizna!5e0!3m2!1ses-419!2sde!4v1761865824183!5m2!1ses-419!2sde"
              class="map"
              title="location-map"
              style="border:0;"
              allowfullscreen=""
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"></iframe>
          </div>
        </div>
        <div class="time-important">
          <div class="timetable">
            <h2 class="timetable__title">{gr.timetable.title}</h2>
            <p class="timetable__text" set:html={gr.timetable.first} />
            <p class="timetable__text" set:html={gr.timetable.second} />
          </div>
          <div class="importants">
            <h2 class="importants__title">{gr.important.title}</h2>
            <ul class="importants__phones">
              {
                gr.important.telephones.map((num) => {
                  return <li class="importants__phone">{num}</li>;
                })
              }
            </ul>
          </div>
        </div>
        <div class="details">
          <p set:html={gr.confirmation} />
          <p set:html={gr.accomodation} />
          <p set:html={gr.food} />
          <div class="details__presents">
            <p>{gr.presents}</p>
            <div class="details__icons">
              <img src="/wedding-gosia-geo/icon-1.png" alt="no flowers" /><img
                src="/wedding-gosia-geo/icon-2.png"
                alt="no gifts"
              />
            </div>
          </div>
        </div>
        <div class="story">
          <h2 class="story__heading" set:html={gr.story.title} />
          <p class="story__text" set:html={gr.story.text} />
        </div>
      </section>
    </main>
  </div>
</Layout>
<style lang="scss">
  .opening {
    @media screen and (min-width: 800px) {
      &__title {
        font-size: 3.7rem;
      }
    }
  }
  .timetable__text,
  .importants__phone {
    font-size: 1.3rem;
  }
</style>
